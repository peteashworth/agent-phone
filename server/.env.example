# agent-phone server environment: TEMPLATE ONLY. Never commit real values.
#
# On the droplet:
#   sudo install -o root -g root -m 600 /dev/null /etc/agent-phone.env
#   sudo nano /etc/agent-phone.env        # paste the lines below and fill in the values
#   sudo ls -l /etc/agent-phone.env       # expect: -rw------- 1 root root
# systemd reads it as root (EnvironmentFile=/etc/agent-phone.env) before starting the service user,
# so it stays root-only (0600). Don't put it in the repo checkout. After editing: sudo systemctl restart agent-phone
#
# Format: KEY=value, one per line, no quotes, no spaces around "=". Leave a line out (or blank) to use the default.
# [A] = needed for Milestone A (place_call + MCP). [B] = safety layer. [C] = call log/dashboard. [D] = brain. Later ones are listed
# so the file only needs to be edited once; the server ignores variables it doesn't use yet.

# ---------------------------------------------------------------- server (defaults are fine; optional)
# [A] Bind address and port. nginx proxies https://jasmine.ashworthhub.com/phone/ to this.
HOST=127.0.0.1
PORT=3600
# [A] Public URL of the /phone prefix as Twilio/ElevenLabs see it. Used for webhook URLs + Twilio signature checks.
PUBLIC_BASE_URL=https://jasmine.ashworthhub.com/phone
# [A] Where the SQLite DB lives. Absolute path on the droplet; owned by the service user.
DATA_DIR=/var/lib/agent-phone

# ---------------------------------------------------------------- safety switches (leave as is)
# [A] Master switch. false = every call is a dry run (nothing dials). Carpet/Jasmine flip it only on an explicit go.
DIALING_ENABLED=false
# [A] Only these destinations may be dialed (comma-separated E.164). Pete only, until hard stops are built + signed off.
ALLOWED_DESTINATIONS=+14358403707
# [A] Hard cap per call, in seconds (Twilio TimeLimit).
MAX_CALL_SECONDS=300
# [B] Calling window, local time at the destination, hours [start, end). Contacts with no time zone set must fit
#     every continental US zone (so effectively 12:00-20:00 Eastern).
CALL_HOURS_START=9
CALL_HOURS_END=20
# [B] Spend caps in USD. A live call reserves its worst case (MAX_CALL_SECONDS at COST_PER_MIN_USD) until it ends.
SPEND_CAP_DAY_USD=5
SPEND_CAP_MONTH_USD=30
# [B] Estimated all-in cost per minute (ElevenLabs + Twilio), used until real per-call costs arrive in Milestone C.
COST_PER_MIN_USD=0.08
# [B] Time zone that defines "today" and "this month" for the caps.
BILLING_TZ=America/Denver
# [B] Minutes Jasmine has to confirm a call to a non-trusted contact before the confirm token expires.
CONFIRM_TTL_MIN=15
# [B] Words/phrases the voice agent must never say (comma-separated, case-insensitive), e.g. Pete's email, home
#     street, private names. Emails, card numbers, SSNs and street addresses are blocked anyway. Secret-ish; root-only file.
PRIVATE_TERMS=
# [B] Milliseconds the close line gets to play before the server hangs up on a hard stop.
HANGUP_DELAY_MS=4500

# ---------------------------------------------------------------- Twilio  (console.twilio.com)
# [A] Account SID, starts with AC. Console home page → Account Info. (Not secret.)
TWILIO_ACCOUNT_SID=AC805bdd863e8fe956c5a6b8001e40c95e
# [A] API key SID, starts with SK. Console → Admin (top right) → Account management → API keys & tokens → Create API key (Standard).
TWILIO_API_KEY_SID=
# [A] That API key's secret. Shown ONCE when the key is created; if lost, make a new key.
TWILIO_API_KEY_SECRET=
# [A] Account Auth Token. Same page (API keys & tokens) → "Auth tokens" → Live credentials → reveal.
#     Used ONLY to verify that webhooks really come from Twilio (signature check). Preferred over WEBHOOK_TOKEN.
TWILIO_AUTH_TOKEN=
# [A] Fallback if you'd rather not put the Auth Token on the droplet: a random string (24+ chars) added to webhook URLs.
#     Generate with: openssl rand -hex 24      (Only one of TWILIO_AUTH_TOKEN / WEBHOOK_TOKEN is needed.)
WEBHOOK_TOKEN=

# ---------------------------------------------------------------- ElevenLabs  (elevenlabs.io)
# [A] API key. elevenlabs.io → Developers (left sidebar) → API Keys → Create. Scopes needed: ElevenLabs Agents
#     (convai) Read + Write. Nothing else. A fresh key just for this server is best.
ELEVENLABS_API_KEY=
# [A] Leave blank for now. Carpet creates the production "Jasmine Phone" agent (after telling Jasmine) and sends you the id.
ELEVENLABS_AGENT_ID=
# [C] Post-call webhook signing secret. Leave blank. Created with the after-call webhook (Agents → Settings → Webhooks);
#     Carpet will send instructions then.
ELEVENLABS_WEBHOOK_SECRET=

# ---------------------------------------------------------------- answering machines + call log  [C]
# [C] Twilio answering-machine detection on every call (~$0.0075/call). Nothing from the brief is said until it gives
#     a verdict. Only machine_*/fax ends the call (end_reason=voicemail); "unknown" or no verdict within AMD_TIMEOUT_S
#     (+1.5s) carries on as human.
AMD_ENABLED=true
AMD_TIMEOUT_S=6
# [C] On a machine: hangup (say nothing) or message (say VOICEMAIL_LINE once, then hang up). Never mentions the purpose.
VOICEMAIL_ACTION=hangup
VOICEMAIL_LINE=Sorry I missed you. Goodbye.
# [C] Keep a copy of each call audio in DATA_DIR/recordings, deleted after RECORDING_RETENTION_DAYS. Transcripts stay.
SAVE_RECORDINGS=true
RECORDING_RETENTION_DAYS=90
# [C] Cost math for the call log: ElevenLabs credits -> USD (Starter plan), Twilio AMD fee per call.
ELEVENLABS_USD_PER_CREDIT=0.0002
AMD_FEE_USD=0.0075

# ---------------------------------------------------------------- dashboard  [C]
# [C] Where the phone service pings the dashboard when a call log changes, plus its bearer token.
#     e.g. DASHBOARD_NOTIFY_URL=https://jasmine-api.ashworthhub.com/notify/calls, token = the dashboard API secret.
#     Blank = no ping (the Calls page also refreshes on its own).
DASHBOARD_NOTIFY_URL=
DASHBOARD_NOTIFY_TOKEN=

# ---------------------------------------------------------------- custom-LLM endpoint + brain  [B]/[D]
# [B] Shared secret ElevenLabs sends to our custom-LLM endpoint (/phone/llm/v1), where the hard stops and output filter
#     run. Generate: openssl rand -hex 24. Also stored as an ElevenLabs workspace secret (Pete pastes it there; Carpet
#     only needs the secret's NAME). Blank = endpoint off (503).
CUSTOM_LLM_SECRET=
# [B] canned = scripted test lines, no model (hard-stop tests). openai = any OpenAI-compatible chat/completions URL [D].
BRAIN=canned
# [D] For BRAIN=openai: full chat/completions URL, API key, model. Not needed until Milestone D; Carpet will ask.
BRAIN_URL=
BRAIN_API_KEY=
BRAIN_MODEL=

# ---------------------------------------------------------------- Milestone D: BRAIN=jasmine  [D]
# BRAIN=jasmine (or brain:"jasmine" per call): Pete's host adapter answers each turn via the phone session. The host
# long-polls GET /phone/brain/next with a brain-scope key (cli: key:create <agent> --scope brain); `brain:status` shows it.
# Seconds the phone session gets to warm up (answer call.start with ready:true) before dialing; else brain_not_ready.
WARM_TIMEOUT_S=90
# Filler lines while a turn is pending (ms after the request); FILLER2 0 = off.
FILLER_AFTER_MS=2500
FILLER2_AFTER_MS=9000
# No answer by then: fixed exit line, then hangup (end_reason brain_timeout).
TURN_TIMEOUT_S=20
# Host counts as offline if it hasn't polled for this long: jasmine calls are refused, live turns exit.
BRAIN_OFFLINE_S=30
# PETE ENTERS THIS HIMSELF, directly in /etc/agent-phone.env. Never in git, chat, logs or prompts. At least 3 words
# (4+ uncommon words recommended). Blank = the personal tier can never unlock.
CODE_PHRASE=
CODE_PHRASE_MAX_ATTEMPTS=3
# Only these callees can ever unlock the personal tier (comma-separated E.164).
PERSONAL_OK_NUMBERS=+14358403707
# Extra words always blocked from speech in every tier (comma-separated), on top of the built-in list.
INTIMATE_TERMS=
# Phone facts with share rules (anyone|code|never), JSON like docs/facts.example.json. root or agent-phone only, 0600.
FACTS_FILE=
